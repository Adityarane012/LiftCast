# LiftCast Environment Variables (Optional)
# Core features (Gemma parser, TabPFN forecasting, SQLite storage) work 100% offline without any API keys.

# Optional: ElevenLabs API Key for studio-quality voice audio briefing.
# If omitted or left blank, LiftCast automatically falls back to the browser's native SpeechSynthesis API.
ELEVENLABS_API_KEY=

# Optional: Ollama server endpoint.
# Defaults to http://localhost:11434 if not specified.
OLLAMA_HOST=http://localhost:11434
